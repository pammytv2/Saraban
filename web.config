<?xml version="1.0" encoding="UTF-8"?>
<!--
  ตั้งค่า IIS สำหรับระบบสารบรรณ (ใช้แทน .htaccess ของ Apache)
  ปิดกั้นไม่ให้เข้าถึงโฟลเดอร์ที่ไม่ใช่ public ผ่าน URL โดยตรง
-->
<configuration>
  <system.webServer>

    <!-- ห้ามเปิดดูรายชื่อไฟล์ในโฟลเดอร์ -->
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- โฟลเดอร์เหล่านี้ห้ามเข้าถึงจาก URL เด็ดขาด (โค้ด/ตั้งค่า/ฐานข้อมูล/ไฟล์แนบ/ล็อก) -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment="app" />
          <add segment="config" />
          <add segment="database" />
          <add segment="storage" />
          <add segment=".backup-ui" />
        </hiddenSegments>
        <!-- ห้ามเรียกไฟล์นามสกุลเหล่านี้ตรงๆ -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
